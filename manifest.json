{
  "manifest_version": 3,
  "name": "Cprompt",
  "version": "1.0",
  "description": "AI Content Generator — Image, Video, and Storytelling automation tool",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://labs.google/*"
  ],
  "action": {
    "default_title": "Open PROMPT&PLAY",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}