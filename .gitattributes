* text=auto

# Windows launchers/scripts should check out with CRLF on Windows.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source, docs, and config remain LF.
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zip binary
